<Window x:Class="PalmSync.Tray.Views.SystemCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync — Sistem kontrolü"
        Width="720" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">

    <DockPanel>
        <!-- ── Header ── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackground}" Padding="18,14"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻ Tekrar kontrol et" Command="{Binding RunCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="🔧 Hepsini düzelt" Command="{Binding FixAllCommand}"
                            Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasFixable}"
                            ToolTip="Düzeltilebilen her şeyi düzeltir. Yönetici gerektirenler için tek bir izin (UAC) istenir." />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource Title}" FontSize="17" />
                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Footer ── -->
        <Border DockPanel.Dock="Bottom" Padding="18,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}"
                Background="{DynamicResource CardBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="📜 Kayıtlar" Command="{Binding OpenLogsCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="📁 Rapor klasörü" Command="{Binding OpenReportsCommand}" Style="{StaticResource GhostButton}" />
                </StackPanel>
                <TextBlock Text="{Binding FooterText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- First-run intro -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14,18,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Background="{DynamicResource AccentSoft}"
                            Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="👋 Hoş geldin! Önce bu bilgisayarı PalmSync için hazırlayalım."
                                       Style="{StaticResource Title}" FontSize="14" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                       Text="Aşağıda kamera, güvenlik duvarı, sertifika, bildirim ve diğer izinlerin durumu var. 'Hepsini düzelt' gerekenleri tek seferde ayarlar (yönetici gerektirenler için Windows bir kez onay ister). Düzeltilemeyen sorunlar, oturuma katılınca ana bilgisayarın kayıtlarına da gönderilir." />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="12"
                                               FontWeight="SemiBold" Margin="2,0,0,6" />
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="16"
                                                                       Width="30" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                        VerticalAlignment="Top" Margin="10,0,0,0">
                                                                <Button Content="Aç" Padding="10,4" Margin="0,0,6,0"
                                                                        Style="{StaticResource SecondaryButton}"
                                                                        ToolTip="İlgili Windows ayarını / sayfayı aç"
                                                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{Binding FixText}" Padding="10,4"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12"
                                                                           Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding Hint, StringFormat=💡 {0}}" Style="{StaticResource Caption}"
                                                                           FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,4,0,0"
                                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Busy overlay -->
            <Border Background="{DynamicResource WindowBackground}" Opacity="0.92"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Body}" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
