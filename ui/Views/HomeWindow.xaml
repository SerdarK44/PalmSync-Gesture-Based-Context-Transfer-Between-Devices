<Window x:Class="PalmSync.Tray.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync"
        Width="460" MinWidth="400" MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">

    <Window.Resources>
        <!-- Grab / Restore + camera + activity: shared by host and joined states -->
        <DataTemplate x:Key="SyncSection">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ActionButton}" Command="{Binding GrabCommand}"
                            ToolTip="Öndeki VS Code dosyasını, tarayıcı sekmesini ve panoyu yakalar">
                        <StackPanel>
                            <TextBlock Text="✊  Yakala" HorizontalAlignment="Center" />
                            <TextBlock Text="açık dosya + pano" FontSize="11" FontWeight="Normal"
                                       Opacity="0.85" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ActionButtonSecondary}" Command="{Binding RestoreCommand}"
                            ToolTip="Son yakalananı bu bilgisayarda açar">
                        <StackPanel>
                            <TextBlock Text="🖐  Geri yükle" HorizontalAlignment="Center" />
                            <TextBlock Text="burada aç" FontSize="11" FontWeight="Normal"
                                       Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding Flash}" Foreground="{DynamicResource Success}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" MinHeight="18" Margin="0,2,0,6" />

                <!-- Camera -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding CameraButtonText}"
                                    Command="{Binding ToggleCameraCommand}" IsEnabled="{Binding CameraAvailable}"
                                    Padding="12,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraOn}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📷  El hareketleri" Style="{StaticResource Title}" FontSize="13" />
                                <TextBlock Text="{Binding CameraStateText}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Visibility="{Binding CameraOn, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <Border Background="{DynamicResource PreviewBg}" CornerRadius="6" HorizontalAlignment="Center"
                                    Width="288" Height="216">
                                <Grid>
                                    <TextBlock Text="Kamera başlatılıyor…" Foreground="#777" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding PreviewFrame}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,6,0">
                                <Run Text="Yakala:" FontWeight="SemiBold" /><LineBreak />
                                <Run Text="elini AÇIK göster (yeşil EL etiketi çıkar), sonra yumruk yap" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}">
                                <Run Text="Geri yükle:" FontWeight="SemiBold" /><LineBreak />
                                <Run Text="yumruğunu yüzünün yanında göster, sonra aç" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent activity (from the logs) -->
                <Border Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Tüm kayıtlar →" Style="{StaticResource GhostButton}"
                                    Padding="4,2" Command="{Binding OpenLogsCommand}" />
                            <TextBlock Text="Son olaylar" Style="{StaticResource Title}" FontSize="13"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Henüz bir şey olmadı. Yakala veya Geri yükle'ye bas."
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding NoRecentEvents, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding RecentEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Time, StringFormat=HH:mm}"
                                                   Width="42" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                        <TextBlock Text="{Binding DisplayFirstLine}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button Content="Oturumu bitir" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Connection status line (dot + text) -->
        <DataTemplate x:Key="StatusRow">
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding StatusBrush}"
                             VerticalAlignment="Top" Margin="0,4,10,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ── Header ── -->
        <Border DockPanel.Dock="Top" Padding="20,14,12,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Divider}" Background="{DynamicResource CardBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- One button: "🔧" when all is well, "⚠ 2" when the system check found problems -->
                    <Button Content="{Binding HealthText}" Command="{Binding OpenSystemCheckCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="ToolTip" Value="Sistem kontrolü ve izinler" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHealthProblems}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="ToolTip" Value="Sistem kontrolü bu bilgisayarda sorun buldu — tıkla, düzelt" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="📜" ToolTip="Kayıtlar (loglar)" Command="{Binding OpenLogsCommand}"
                            Style="{StaticResource GhostButton}" FontSize="16" />
                    <Button Content="❔" ToolTip="Sorun giderme" Command="{Binding TroubleshootCommand}"
                            Style="{StaticResource GhostButton}" FontSize="16" />
                    <Button Content="⚙" ToolTip="Ayarlar" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource GhostButton}" FontSize="16" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/palmsync-logo.png" Height="42" Width="132"
                           Stretch="Uniform" VerticalAlignment="Center" />
                    <Border CornerRadius="10" Padding="8,2" Margin="12,2,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource Subtle}"
                            Visibility="{Binding ShowSyncButtons, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PillText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Update banner ── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoft}" Padding="20,10"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}"
                Visibility="{Binding UpdateVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Bu sürümü atla" Command="{Binding SkipUpdateCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                    <Button Content="{Binding UpdateButtonText}" Command="{Binding InstallUpdateCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="12,5" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="⬆ Güncelleme var" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Body (scrolls when the screen is short) ── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16,20,18">

                <!-- ============ IDLE ============ -->
                <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Çalışma alanını iki bilgisayar arasında taşı."
                               Style="{StaticResource Body}" Foreground="{DynamicResource SecondaryText}"
                               TextAlignment="Center" Margin="0,4,0,18" />

                    <Button Style="{StaticResource ActionButton}" Command="{Binding StartHostingCommand}"
                            MinHeight="64" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Oturum başlat" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Bu bilgisayar ev sahibi olsun" FontSize="12" FontWeight="Normal"
                                       Opacity="0.85" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionButtonSecondary}" Command="{Binding ShowConnectCommand}"
                            MinHeight="64">
                        <StackPanel>
                            <TextBlock Text="Oturuma katıl" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Text="Diğer bilgisayardaki kodla bağlan" FontSize="12" FontWeight="Normal"
                                       Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Nasıl çalışır?" Style="{StaticResource Title}" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" LineHeight="20">
                                <Run Text="1." FontWeight="Bold" /> <Run Text="Bir bilgisayarda Oturum başlat — kod ve şifre çıkar." /><LineBreak />
                                <Run Text="2." FontWeight="Bold" /> <Run Text="Diğerinde Oturuma katıl ve kodu + şifreyi gir." /><LineBreak />
                                <Run Text="3." FontWeight="Bold" /> <Run Text="Birinde Yakala, diğerinde Geri yükle (ya da el hareketi)." />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="İki bilgisayar da aynı Wi-Fi / ağda olmalı." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ CONNECT INPUT ============ -->
                <StackPanel Visibility="{Binding IsConnectInput, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Diğer bilgisayarda görünen kodu ve şifreyi gir."
                               Style="{StaticResource Body}" TextAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="İki bilgisayar da aynı Wi-Fi / ağda olmalı."
                               Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,0,0,18" />

                    <TextBlock Text="Kod" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding InputCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" FontSize="18" FontFamily="Consolas"
                             CharacterCasing="Upper" Margin="0,0,0,14" />

                    <TextBlock Text="Şifre" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding InputPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" FontSize="18" FontFamily="Consolas"
                             CharacterCasing="Upper" Margin="0,0,0,20" />

                    <Button Style="{StaticResource ActionButton}" Content="Bağlan" Command="{Binding JoinCommand}"
                            IsDefault="True" Margin="0,0,0,8" />
                    <Button Content="← Geri" Command="{Binding BackCommand}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ============ HOSTING ============ -->
                <StackPanel Visibility="{Binding IsHosting, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Diğer bilgisayarda bunları gir:" Style="{StaticResource Caption}"
                                       FontSize="12" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="KOD" Style="{StaticResource Caption}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="📋" ToolTip="Kodu kopyala"
                                                Command="{Binding CopyCodeCommand}" Style="{StaticResource GhostButton}" />
                                        <TextBlock Text="{Binding Code}" FontSize="22" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ŞİFRE" Style="{StaticResource Caption}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="📋" ToolTip="Şifreyi kopyala"
                                                Command="{Binding CopyPasswordCommand}" Style="{StaticResource GhostButton}" />
                                        <TextBlock Text="{Binding Password}" FontSize="22" FontWeight="Bold"
                                                   FontFamily="Consolas" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                <Run Text="Bu bilgisayarın adresi:" /> <Run Text="{Binding HostIp, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusRow}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SyncSection}" />
                </StackPanel>

                <!-- ============ CONNECTED (joined) ============ -->
                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusRow}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SyncSection}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
