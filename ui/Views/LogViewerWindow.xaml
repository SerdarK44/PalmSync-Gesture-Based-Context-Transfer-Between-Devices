<Window x:Class="PalmSync.Tray.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync — Kayıtlar"
        Width="1000" Height="640" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- view switch + live -->
            <RowDefinition Height="Auto" />   <!-- filters -->
            <RowDefinition Height="*" />      <!-- grid -->
            <RowDefinition Height="Auto" />   <!-- splitter -->
            <RowDefinition Height="Auto" MinHeight="0" />   <!-- details -->
            <RowDefinition Height="Auto" />   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: view mode (left) + actions (right) ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📋 Kopyala" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5"
                        Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedItems, ElementName=Grid}"
                        ToolTip="Seçili satırları (seçim yoksa görünen tümünü) panoya kopyala" />
                <Button Content="📦 Dışa aktar" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5"
                        Command="{Binding ExportCommand}"
                        ToolTip="Tüm kayıt dosyaları + sorun giderme raporu tek bir .zip dosyasında (hata bildirmek için)" />
                <Button Content="📁" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="10,5"
                        Command="{Binding OpenFolderCommand}" ToolTip="{Binding LogDir}" />
                <Button Content="🧹" Style="{StaticResource SecondaryButton}" Padding="10,5"
                        Command="{Binding ClearViewCommand}"
                        ToolTip="Listeyi temizle (dosyalar silinmez, yeni kayıtlar gelmeye devam eder)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="mode" IsChecked="{Binding FriendlyMode}" Style="{StaticResource Chip}"
                             ToolTip="Yakalama, geri yükleme, bağlantı ve hatalar — sade Türkçe">
                    <TextBlock Text="⭐ Önemli olaylar" />
                </RadioButton>
                <RadioButton GroupName="mode" IsChecked="{Binding AllMode}" Style="{StaticResource Chip}"
                             ToolTip="Her teknik satır (hata ayıklama için)">
                    <TextBlock Text="📜 Tüm kayıtlar" />
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- ── Row 1: search + filters (left) + counters / live (right) ── -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ShowErrorsCommand}" Style="{StaticResource GhostButton}"
                        ToolTip="Sadece hataları göster">
                    <TextBlock>
                        <Run Text="⛔" /> <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold"
                                              Foreground="{DynamicResource Error}" /> <Run Text="hata" />
                    </TextBlock>
                </Button>
                <Button Command="{Binding ShowWarningsCommand}" Style="{StaticResource GhostButton}"
                        ToolTip="Uyarı ve hataları göster" Margin="0,0,6,0">
                    <TextBlock>
                        <Run Text="⚠" /> <Run Text="{Binding WarnCount, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource Warning}" /> <Run Text="uyarı" />
                    </TextBlock>
                </Button>
                <ToggleButton IsChecked="{Binding Paused}" Style="{StaticResource Chip}" Margin="0"
                              ToolTip="Yeni kayıtların gelmesini duraklat / sürdür">
                    <TextBlock Text="{Binding LiveText}" />
                </ToggleButton>
            </StackPanel>

            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Levels}" SelectedItem="{Binding MinLevel}"
                      Width="150" Margin="0,0,12,0" IsEnabled="{Binding AllMode}"
                      ToolTip="En düşük önem seviyesi (Tüm kayıtlar görünümünde)" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"
                      Width="130" Margin="0,0,8,0" ToolTip="Hangi bileşenin kayıtları" />

            <Grid Margin="0,0,8,0" MinWidth="140">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" FontSize="13" Padding="8,5,28,5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="🔍 Ara… (Ctrl+F)" IsHitTestVisible="False" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                        Padding="8,2" Margin="0,0,2,0" ToolTip="Aramayı ve filtreleri sıfırla"
                        Command="{Binding ClearFiltersCommand}" />
            </Grid>
        </DockPanel>

        <!-- ── Row 2: entries ── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="Grid"
                          ItemsSource="{Binding View}"
                          SelectedItem="{Binding Selected}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          CanUserSortColumns="False" CanUserReorderColumns="False"
                          RowHeight="26" FontSize="12.5"
                          BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Subtle}"
                          Foreground="{DynamicResource TextForeground}"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSoft}" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Saat" Binding="{Binding TimeText}" Width="112">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                    <Setter Property="ToolTip" Value="{Binding DateText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Seviye" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                    <Setter Property="ToolTip" Value="{Binding Component}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Mesaj" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding FirstLine}" />
                                                <Setter Property="FontFamily" Value="Consolas" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.FriendlyMode, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="Text" Value="{Binding DisplayFirstLine}" />
                                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                                        <Setter Property="FontSize" Value="13" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Margin="20" IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />

        <!-- ── Row 4: details of the selected entry ── -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,8" MinHeight="70" Height="110">
            <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource TextForeground}"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- ── Row 5: status bar ── -->
        <DockPanel Grid.Row="5" Margin="2,8,2,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LevelHint}" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}" />
        </DockPanel>
    </Grid>
</Window>
