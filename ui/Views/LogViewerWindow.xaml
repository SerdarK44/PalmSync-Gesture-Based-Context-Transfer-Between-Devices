<Window x:Class="PalmSync.Tray.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync Logs"
        Width="820" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Level:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextForeground}" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding LevelFilters}"
                      SelectedItem="{Binding SelectedLevel}"
                      Width="110" Margin="0,0,12,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Padding="14,6" Margin="0,0,10,0"
                    Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" />
            <Button Content="Export" Command="{Binding ExportCommand}" Padding="14,6" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Entries}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontFamily="Consolas" FontSize="12"
                  Background="{DynamicResource CardBackground}"
                  Foreground="{DynamicResource TextForeground}"
                  RowBackground="{DynamicResource CardBackground}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="150" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
