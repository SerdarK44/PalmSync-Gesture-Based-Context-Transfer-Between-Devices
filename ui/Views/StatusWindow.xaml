<Window x:Class="PalmSync.Tray.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync Status"
        Width="520" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <StackPanel Margin="16">

        <TextBlock Text="Connection Status" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" />
        <Border Background="{Binding StatusBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="White"
                           FontWeight="Bold" FontSize="15" />
                <TextBlock Text="{Binding ConnectionDetails}" Foreground="White"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Text="Daemon Process" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                    CornerRadius="6" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Processes" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding CpuUsage}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextForeground}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource CardBackground}"
                    CornerRadius="6" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Memory" Foreground="{DynamicResource SecondaryText}" />
                    <TextBlock Text="{Binding MemoryUsage}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextForeground}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Last Log Entry" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextForeground}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="12">
            <TextBlock Text="{Binding LastLogLine}" FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource TextForeground}" TextWrapping="Wrap" />
        </Border>

        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                Padding="16,8" Margin="0,16,0,0" HorizontalAlignment="Left"
                Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" />
    </StackPanel>
</Window>
