<Window x:Class="PalmSync.Tray.Views.TroubleshootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalmSync — Sorun giderme"
        Width="600" Height="580" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}">

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Body}" Margin="0,0,0,10"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Oturum bağlanmıyorsa bunu İKİ bilgisayarda da çalıştırıp karşılaştır. Katılan bilgisayardaki 'Ev sahibine erişim' satırı sorunun ağda olup olmadığını söyler." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="📜 Kayıtları aç" Command="{Binding OpenLogsCommand}"
                    Style="{StaticResource GhostButton}" />
            <Button DockPanel.Dock="Left" Content="🔧 Sistem kontrolü" Command="{Binding OpenSystemCheckCommand}"
                    Style="{StaticResource GhostButton}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📋 Kopyala" Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" />
                <Button Content="↻ Yeniden çalıştır" Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="4">
            <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource TextForeground}"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Padding="8"
                     VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
