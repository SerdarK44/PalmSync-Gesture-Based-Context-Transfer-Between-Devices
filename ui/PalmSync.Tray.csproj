<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>palmsync-ui</AssemblyName>
    <RootNamespace>PalmSync.Tray</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon Condition="Exists('Assets\palmsync.ico')">Assets\palmsync.ico</ApplicationIcon>
    <!-- Output paths (WDAC workaround) are set in Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets\palmsync.ico')">
    <Resource Include="Assets\palmsync.ico" />
    <Resource Include="Assets\palmsync-logo.png" />
  </ItemGroup>

</Project>
