<Application x:Class="PalmSync.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the theme: ThemeService swaps it at runtime -->
                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <tb:TaskbarIcon x:Key="TrayIconResource"
                            IconSource="/Assets/palmsync.ico"
                            ToolTipText="{Binding StatusText}"
                            DoubleClickCommand="{Binding OpenHomeCommand}">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="PalmSync'i aç" Command="{Binding OpenHomeCommand}"
                                  FontWeight="Bold" />
                        <Separator />
                        <MenuItem Header="Kayıtlar (loglar)" Command="{Binding OpenLogsCommand}" />
                        <MenuItem Header="Sistem kontrolü ve izinler" Command="{Binding OpenSystemCheckCommand}" />
                        <MenuItem Header="Sorun giderme" Command="{Binding OpenTroubleshootCommand}" />
                        <MenuItem Header="Ayarlar" Command="{Binding OpenSettingsCommand}" />
                        <Separator />
                        <MenuItem Header="Çıkış" Command="{Binding ExitCommand}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
